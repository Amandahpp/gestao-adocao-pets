@startuml
title Diagrama de classes - domínio
skinparam classAttributeIconSize 0

abstract class Animal {
  -id
  -nome
  -idade
  -sexo
  -status
  +exibir_dados()
}

class Cachorro {
  -raca
  +exibir_dados()
}

class Gato {
  -pelagem
  +exibir_dados()
}

class AnimalFactory <<Factory>> {
  {static} +criar_animal(tipo, *args)
}

class Adotante {
  -nome
  -cpf
  -telefone
  +exibir_dados()
}

class Abrigo <<Singleton>> {
  {static} -instancia
  -nome
  -animais
  -solicitacoes
  +cadastrar_animal(animal)
  +cadastrar_solicitacao(solicitacao)
}

class SolicitacaoAdocao {
  -animal
  -adotante
  -estado
  +status
  +aprovar()
  +rejeitar()
  +exibir()
}

abstract class EstadoSolicitacao <<State>> {
  +nome
  +aprovar(solicitacao)
  +rejeitar(solicitacao)
}

class EstadoPendente
class EstadoAprovada
class EstadoRejeitada

Animal <|-- Cachorro
Animal <|-- Gato
AnimalFactory ..> Cachorro : cria
AnimalFactory ..> Gato : cria

Abrigo "1" o-- "0..*" Animal
Abrigo "1" o-- "0..*" SolicitacaoAdocao
SolicitacaoAdocao "*" --> "1" Animal
SolicitacaoAdocao "*" --> "1" Adotante
SolicitacaoAdocao --> "1" EstadoSolicitacao : estado atual

EstadoSolicitacao <|-- EstadoPendente
EstadoSolicitacao <|-- EstadoAprovada
EstadoSolicitacao <|-- EstadoRejeitada

note right of EstadoPendente
  Ao aprovar, muda o status
  do animal para "Adotado".
end note
@enduml
